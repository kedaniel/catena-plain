# --- Required: one model provider ---
# Pick ONE of the blocks below. Everything else in the app works the same either way.

# A) Claude (paid credits; best quality). Use a key from a dedicated Console
#    workspace that has its own spend limit (see README).
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# B) A free or cheaper provider. Set LLM_PROVIDER to one of:
#    gemini | deepseek | groq | openrouter | custom
#    Leave ANTHROPIC_API_KEY unset when using this.
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=                # required for groq/openrouter/custom; optional otherwise
# LLM_BASE_URL=             # only for LLM_PROVIDER=custom

# Access codes, comma-separated. One shared code, or one per person so you can revoke one.
# These get the FULL version: English, Arabic or both.
ACCESS_CODES=change-me-to-something-long

# Codes that get the ARABIC version instead: Arabic interface, Arabic output only.
ARABIC_ACCESS_CODES=theo-26

# --- Recommended: usage store (Upstash Redis, free tier) ---
# Needed for the monthly budget, daily cap and per-person limits to work reliably.
# Adding Upstash from the Vercel Marketplace fills these in automatically (KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning ---
# Soft monthly budget in US dollars, tracked by the app. Set a bit BELOW the Console workspace limit.
MONTHLY_BUDGET_USD=5
# Max requests for the whole app per day (UTC).
DAILY_REQUEST_LIMIT=150
# Max requests per access code per hour.
PER_CODE_HOURLY_LIMIT=15

# Prices per million tokens, used only to estimate spend for MONTHLY_BUDGET_USD.
# Defaults match Claude Haiku 5.5. On a FREE tier set both to 0, which turns the
# dollar budget off; DAILY_REQUEST_LIMIT and PER_CODE_HOURLY_LIMIT still apply.
INPUT_PRICE_PER_MTOK=0.10
OUTPUT_PRICE_PER_MTOK=0.50
# Claude Sonnet 5.5 instead: INPUT_PRICE_PER_MTOK=2, OUTPUT_PRICE_PER_MTOK=10

MAX_OUTPUT_TOKENS=2500
MAX_INPUT_CHARS=15000

# How long finished answers are cached, in days. A cached passage costs nothing to re-read.
CACHE_DAYS=180
